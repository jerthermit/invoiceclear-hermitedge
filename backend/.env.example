# Backend configuration; export selected variables or set them in Railway.
# The app does not automatically load .env files.
# Public walkthrough defaults: /api/runtime publishes these demo credentials.
# Use only permitted non-confidential records in the public workspace.
INVOICECLEAR_MODE=demo
INVOICECLEAR_EMAIL=finance@invoiceclear.demo
INVOICECLEAR_PASSWORD=invoiceclear-demo
INVOICECLEAR_PROVIDER=rules
INVOICECLEAR_BACKUPS_ENABLED=true

# Local development overrides only. Leave both unset on Railway so the image
# binds 0.0.0.0 and the application uses Railway's assigned PORT.
# INVOICECLEAR_HOST=127.0.0.1
# INVOICECLEAR_PORT=8100

# Railway: use backend/ as the service root and mount a persistent volume at
# /data. For Railway's root-owned mount, set RAILWAY_RUN_UID=0 in Railway only.
# The container bootstrap prepares only /data itself, then drops to UID/GID
# 10001 before starting the API. It never changes existing files' ownership;
# inaccessible files need manual recovery. The image defaults to a non-root user.
# Set the database path for the chosen mode on that mounted volume:
# Public walkthrough:
# INVOICECLEAR_DB_PATH=/data/invoiceclear-public-202611-artifacts.sqlite3
# Private workspace: change INVOICECLEAR_MODE to private and replace the demo
# email/password above with a unique email and a password of 16+ characters.
# INVOICECLEAR_DB_PATH=/data/invoiceclear-private.sqlite3
# Allow only the exact deployed frontend HTTPS origin, without path or wildcard.
# INVOICECLEAR_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# The backend key enables case investigation after restart. Each run still
# requires confirmation before sending evidence and uses the shared daily budget.
# TOGETHER_API_KEY=
# TOGETHER_MODEL=zai-org/GLM-5.3-Flash
# INVOICECLEAR_AGENT_ENABLED=false

# Optional model extraction uses the same key. Keep rules to avoid model calls on upload.
# INVOICECLEAR_PROVIDER=together

# Connections are private-workspace only. Never put these values in frontend configuration.
# Register these exact callbacks in the developer apps:
#   INVOICECLEAR_PUBLIC_URL/api/connections/qbo/callback
#   INVOICECLEAR_PUBLIC_URL/api/connections/gmail/callback
# Local origins below; on Railway replace both with the exact backend/frontend
# HTTPS origins respectively, and register the matching backend callback URLs.
# INVOICECLEAR_PUBLIC_URL=http://localhost:8100
# INVOICECLEAR_FRONTEND_URL=http://localhost:8100
# INVOICECLEAR_TOKEN_KEY=  # Generate once; retain securely with your backups.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox
# QBO_PO_FIELD_ID=  # Existing invoice CustomField DefinitionId used for customer PO references.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
